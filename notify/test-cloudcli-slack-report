#!/usr/bin/env bash
# Checks the report shape rules in cloudcli-slack-report. Run: notify/test-cloudcli-slack-report
set -uo pipefail
cmd="$(dirname "$0")/cloudcli-slack-report"
fail=0

ok()  { "$cmd" -n "$@" >/dev/null 2>&1 && return 0
        printf 'FAIL: expected accept: %s\n' "$*" >&2; fail=1; }
no()  { "$cmd" -n "$@" >/dev/null 2>&1 && { printf 'FAIL: expected reject: %s\n' "$*" >&2; fail=1; }; }

five="- one
- two
- three
- four
- five"

ok -t t -m "2 of 47 failing"
ok -t t -m "2 of 47 failing" -s "- both failures are in auth/session, not the new code"
ok -t t -m "2 of 47 failing" -s "$five"

no -t t -m "2 of 47 failing" -s "Both failures are in auth/session, so the refresh path is suspect."
no -t t -m "2 of 47 failing" -s "- this bullet has thirteen words in it which is one word too many"
no -t t -m "2 of 47 failing" -s "$five
- six"
no -t t -m "this message keeps going and going and going and going and going past the cap"
no -t t -m "first line
second line"

[ "$fail" -eq 0 ] && echo "all shape checks pass"
exit "$fail"
