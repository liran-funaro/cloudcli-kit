[Unit]
Description=CloudCLI - Claude Code web UI (loopback only)
After=network-online.target

[Service]
Type=simple
Environment=HOST=127.0.0.1
Environment=PORT=3001
# Mid-turn steering (patch 5) is on by whatever the launcher defaults to, which
# since 2026-08-13 is on. To reverse it, add the line below and restart -- the
# launcher un-applies every server edit that belongs to it, and to the half of
# patch 10 that rides on it, when the flag is 0. An
# Environment=CLOUDCLI_STEER=1 line used to live here and became a line that
# said nothing, which is why the knob is now named only where it does something.
# Environment=CLOUDCLI_STEER=0
# Clickable file paths (patch 11) are on the same way. Reversing them also takes
# back the one read the file-tree API is allowed to make outside a project root,
# which is what opens a report an agent wrote into /tmp.
# Environment=CLOUDCLI_LINKS=0
# The token counter measures against CONTEXT_WINDOW, which upstream defaults to
# 160000. Name your model's real window here or the dialog reports that default
# as fact -- a 1M-context model spends most of a long session above it.
# Environment=CONTEXT_WINDOW=1000000
# Login shell so PATH/node and the Claude gateway env from ~/.bashrc apply.
ExecStart=/bin/bash -lc '%h/bin/cloudcli-start'
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
