[Unit]
Description=CloudCLI - Claude Code web UI (loopback only)
After=network-online.target

[Service]
Type=simple
Environment=HOST=127.0.0.1
Environment=PORT=3001
# The SDK ships its own CLI, and 0.3.263's catalog has never heard of Opus 5.5:
# it resolves `opus` to claude-opus-5 and warns unrecognized_model if handed 5.5,
# assuming a 200k window for auto-compact. Point it at the installed CLI, which
# knows the model and its real window.
Environment=CLAUDE_CLI_PATH=%h/.local/bin/claude
# The alias pin (see README) exists because the gateway once 403'd on
# claude-opus-5-5. The team allow-list carries it now, so the pin names it
# instead of holding sessions back on Opus 5. CLOUDCLI_MODEL_PIN=none drops the
# rewrite entirely and lets the CLI's own default stand.
Environment=CLOUDCLI_MODEL_PIN=claude-opus-5-5
# Mid-turn steering (patch 5) is on by whatever the launcher defaults to, which
# since 2026-08-13 is on. To reverse it, add the line below and restart -- the
# launcher un-applies every server edit that belongs to it, and to the half of
# patch 10 that rides on it, when the flag is 0. An
# Environment=CLOUDCLI_STEER=1 line used to live here and became a line that
# said nothing, which is why the knob is now named only where it does something.
# Environment=CLOUDCLI_STEER=0
# Clickable file paths (patch 11) are on the same way. Reversing them also takes
# back the one read the file-tree API is allowed to make outside a project root,
# which is what opens a report an agent wrote into /tmp.
# Environment=CLOUDCLI_LINKS=0
# The token counter reads the window out of what the CLI reports per model, and
# falls back to CONTEXT_WINDOW for any message that reports none -- upstream's
# default for that is 160000, which a 1M-context model spends a long session
# above. Name yours here and nothing has to guess.
# Environment=CONTEXT_WINDOW=1000000
# Login shell so PATH/node and the Claude gateway env from ~/.bashrc apply.
ExecStart=/bin/bash -lc '%h/bin/cloudcli-start'
# Always, not on-failure: an unattended session is only as durable as the server
# under it, and a clean exit or an outside kill is exactly when nobody is
# watching. The autonomy loop picks armed sessions back up on the way in.
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
