STEER_BLOCK = r'''// KIT: mid-turn steering -----------------------------------------------------
// The SDK spawns the CLI with --input-format stream-json unconditionally, and
// the string-prompt path writes one user frame without calling endInput(), so
// stdin is still open while the turn runs. A user frame pushed into it is read
// at the next agent-loop boundary -- the same turn, no restart, no resume.
const kitSteerable = new WeakSet(); // runs whose stdin is still writable
const kitInboxes = new WeakMap(); // run -> its push queue
let kitPromptWasString = false;
function kitTapPrompt(prompt) {
    // A string prompt leaves stdin open. The generator payload (a turn carrying
    // attachments) ends, and streamInput() closes stdin behind it, so those
    // runs cannot be steered -- and must not be, or the message would vanish
    // into a closed pipe. Read at the query() call site, with no await between
    // here and the kitSteerable.add() below, so the flag cannot drift to
    // another run.
    kitPromptWasString = typeof prompt === 'string';
    return prompt;
}
function kitPushQueue() {
    // Yields on push and ends only when closed. Ending it would call
    // endInput() and close the stdin that interrupt() needs.
    const items = [];
    let wake = null;
    let closed = false;
    return {
        push(value) { items.push(value); wake?.(); wake = null; },
        close() { closed = true; wake?.(); wake = null; },
        async *[Symbol.asyncIterator]() {
            for (;;) {
                if (items.length) {
                    yield items.shift();
                    continue;
                }
                if (closed) {
                    return;
                }
                await new Promise((resolve) => { wake = resolve; });
            }
        },
    };
}
function kitCloseInbox(instance) {
    const inbox = instance && kitInboxes.get(instance);
    if (!inbox) {
        return;
    }
    kitInboxes.delete(instance);
    inbox.close();
}
/**
 * KIT: writes a steered line into the CLI's own transcript.
 *
 * The CLI applies a mid-turn frame to the run in flight but records nothing, so
 * after a reload the message is simply gone -- CloudCLI reads its history from
 * that transcript and there is no second copy anywhere. Append it in the shape
 * the CLI writes for a user turn, chained onto the newest entry: the reader
 * takes it for a normal user message, and the CLI replays it on the next resume
 * rather than continuing a conversation it has no record of being redirected.
 * @param {string} sessionId - Session identifier
 * @param {string} text - What was said to the run
 * @param {string} timestamp - When it was said, ISO 8601, for history ordering
 * @returns {Promise<void>} Resolves once the line is on disk
 */
async function kitRecordSteer(sessionId, text, timestamp) {
    const jsonlPath = sessionsDb.getSessionById(sessionId)?.jsonl_path;
    if (!jsonlPath) {
        return;
    }
    // Only the tail is wanted: these transcripts reach tens of megabytes, and
    // all that is needed from one is an entry to hang the new line off.
    const handle = await fs.open(jsonlPath, 'r');
    let tail = '';
    let start = 0;
    try {
        const { size } = await handle.stat();
        start = Math.max(0, size - 65536);
        if (size > start) {
            const buffer = Buffer.alloc(size - start);
            await handle.read(buffer, 0, buffer.length, start);
            tail = buffer.toString('utf8');
        }
    }
    finally {
        await handle.close();
    }
    const lines = tail.split('\n');
    if (start > 0) {
        lines.shift();              // the read began mid-line
    }
    let base = null;
    for (let index = lines.length - 1; index >= 0 && !base; index--) {
        const line = lines[index].trim();
        if (!line) {
            continue;
        }
        try {
            const entry = JSON.parse(line);
            if (entry?.uuid && entry.sessionId) {
                base = entry;       // the newest entry that can be a parent
            }
        }
        catch {
            // A line still being written. The one before it will do.
        }
    }
    if (!base) {
        return;
    }
    // sessionId here is CloudCLI's; the transcript is keyed by the CLI's own,
    // which is what the reader filters on -- so take that from the file.
    const record = {
        parentUuid: base.uuid,
        isSidechain: false,
        userType: base.userType || 'external',
        cwd: base.cwd,
        sessionId: base.sessionId,
        version: base.version,
        gitBranch: base.gitBranch,
        entrypoint: base.entrypoint,
        type: 'user',
        message: { role: 'user', content: [{ type: 'text', text }] },
        promptSource: 'sdk',
        promptId: base.promptId || crypto.randomUUID(),
        uuid: crypto.randomUUID(),
        timestamp,
    };
    // One line, one write: O_APPEND keeps it whole alongside the CLI's own
    // appends. No trailing newline means the CLI is mid-write, so start one.
    await fs.appendFile(jsonlPath,
        (tail.endsWith('\n') ? '' : '\n') + JSON.stringify(record) + '\n');
}
/**
 * KIT: hands a user message to a run that is already in flight.
 * @param {string} sessionId - Session identifier
 * @param {string} text - What to say to the run
 * @returns {boolean} True if the CLI has it; false to fall back to refusing
 */
function injectIntoClaudeSDKSession(sessionId, text) {
    const session = getSession(sessionId);
    const instance = session?.instance;
    if (!instance || session.status !== 'active') {
        return false;
    }
    if (!kitSteerable.has(instance) || typeof instance.streamInput !== 'function') {
        return false;
    }
    if (typeof text !== 'string' || !text.trim()) {
        return false;
    }
    let inbox = kitInboxes.get(instance);
    if (!inbox) {
        inbox = kitPushQueue();
        kitInboxes.set(instance, inbox);
        // Settles only once the queue closes. A rejection means the CLI is
        // already gone, which the run loop is about to notice by itself.
        instance.streamInput(inbox).catch((error) => {
            console.warn(`[KIT] steering channel closed for ${sessionId}:`, error?.message || error);
        });
    }
    console.log(`[KIT] steering ${sessionId} mid-turn (${text.length} chars)`);
    const timestamp = new Date().toISOString();
    inbox.push({
        type: 'user',
        session_id: '',
        message: { role: 'user', content: [{ type: 'text', text }] },
        parent_tool_use_id: null,
    });
    // Not awaited: the run already has the message, and whether it also ends up
    // in the history must not decide whether steering reports success.
    kitRecordSteer(sessionId, text, timestamp).catch((error) => {
        console.warn(`[KIT] steered line not recorded for ${sessionId}:`, error?.message || error);
    });
    return true;
}
'''

