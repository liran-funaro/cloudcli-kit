'''

WAIT_HOLD = r'''                if (backgroundWorkPending || kitTasks.length) {
                    // Work started during this turn is still running. Hold the process
                    // open so it can finish and report back in a follow-up turn; the
                    // ceiling is only a backstop for work that never reports.
                    // KIT: `kitTasks.length` holds for anything the CLI still lists,
                    // even when this turn did not start it -- a turn resumed mid-wait
                    // must not release what the turn before it armed.
                    backgroundWorkPending = false;
                    heldForBackgroundWork = true;
