SETTINGS = re.compile(r'(s\.jsx\("div",\{className:"hidden px-2 py-1\.5 md:block",'
                      r'children:s\.jsxs\("button",\{className:"flex w-full items-'
                      r'center gap-2 rounded-lg px-2\.5 py-1\.5 text-muted-foreground '
                      r'transition-colors hover:bg-accent/60 hover:text-foreground",'
                      r'onClick:(\w+),)')
if len(SETTINGS.findall(s)) == 1 and not re.search(r'\b__kitCost\w*\b', s):
