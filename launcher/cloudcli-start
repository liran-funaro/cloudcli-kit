# --- patch 10: the wait, said out loud ---------------------------------------
# A turn that ends with background work still running is the one case where
# CloudCLI shows a finished turn and means "still waiting". Upstream holds the
# CLI's stdin open for it (up to BG_WAIT_CEILING_MS) so the work can report back
# in a follow-up turn -- but the client is told `complete` when the first
# `result` lands, and nothing is sent when the hold starts, when it ends, or when
# it runs out. A session waiting on a test looks exactly like a session that
# stopped, which is how "it timed out and said nothing" happens.
#
# Three things, in one block because they are one story:
#
#   the rows      the hold, the report-back, and the expiry each become an
#                 ordinary assistant row, so the transcript says what the
#                 session is doing. Not gated on CLOUDCLI_STEER: it adds to a
#                 turn's account of itself and takes nothing away.
#   the ceiling   the wait lasts as long as the turn said it needs -- a Monitor
#                 armed for 50 minutes cannot report inside a 30-minute hold --
#                 bounded by KIT_WAIT_CEILING_MAX_MS, and the CLI is given that
#                 bound so the server's per-run figure is the one that decides.
#   the resume    a message that lands mid-wait goes INTO the held CLI instead of
#                 starting a run that supersedes it. That is the part that keeps
#                 the work alive: addSession interrupts a superseded run and
#                 releases its stdin, taking every background shell and monitor
#                 with it -- which is why prodding a waiting session was answered
#                 by "No completion record was found for this background shell
#                 command from the previous session". Steering already owns the
#                 pipe this needs, so the resume half rides on patch 5 and is
#                 gated with it.
#
# What the CLI does with a frame pushed into a parked stream is not inferred: a
# probe against 2.1.235 pushed one after the first `result` and the CLI ran it as
# an ordinary turn, wrote it into its own transcript (unlike a mid-turn steer,
# which patch 5 has to record itself), and the background shell armed by the turn
# before it survived and reported back afterwards.
WAIT_BLOCK = r'''
// KIT: the outer bound on a hold, and what the CLI itself is given. Upstream's
// 30 minutes is a floor: the tools name their own deadlines (a Monitor's
// timeout_ms is up to an hour), and work that cannot report before its container
// is torn down can only ever look like work that never reported.
const KIT_WAIT_CEILING_MAX_MS = 60 * 60 * 1000;
/**
 * KIT: a wait, as a row. Everything it says is in `content`, so a bundle without
 * the kit's browser half reads it as the sentence it is; `wait` beside it is only
 * how the patched one draws it (a countdown, a draining bar, the task list).
 */
function kitWaitRow(sessionId, content, wait) {
    return createNormalizedMessage({
        sessionId,
        provider: 'claude',
        kind: 'text',
        role: 'assistant',
        content,
        wait,
    });
}
/** KIT: a duration the way the CLI writes one. */
function kitFor(ms) {
    const secs = Math.max(0, Math.round(ms / 1000));
    return secs < 60 ? `${secs}s` : `${Math.floor(secs / 60)}m ${secs % 60}s`;
}
/**
 * KIT: how long the work a message starts says it needs, in ms. A Monitor names
 * its own deadline; a persistent one names none, so it gets the outer bound. A
 * background shell carries the Bash timeout, which is capped well inside the
 * floor and so never stretches anything. Zero means "no opinion".
 */
function kitArmedWaitMs(sdkMessage) {
    const content = sdkMessage?.message?.content;
    if (!Array.isArray(content)) {
        return 0;
    }
    let armed = 0;
    for (const block of content) {
        if (block?.type !== 'tool_use') {
            continue;
        }
        if (block.name === 'Monitor') {
            armed = Math.max(armed, block.input?.persistent === true
                ? KIT_WAIT_CEILING_MAX_MS
                : Number(block.input?.timeout_ms) || 0);
        }
        else if (block.name === 'Bash' && block.input?.run_in_background === true) {
            armed = Math.max(armed, Number(block.input?.timeout) || 0);
        }
    }
    return armed;
}
/** KIT: what the row says while the wait is on, and when a message ends it. */
function kitWaitText(tasks, ms) {
    const what = tasks.length === 0 ? 'background work'
        : tasks.length === 1 ? '1 background task'
            : `${tasks.length} background tasks`;
    // A ceiling is an approximation, so say it like one: whole minutes.
    const window = ms >= 90000 ? `${Math.round(ms / 60000)}m` : kitFor(ms);
    return `Waiting on ${what} · up to ${window}`;
}
function kitKeptText(tasks) {
    if (tasks.length === 0) {
        return 'Continued in the same process, so the background work survives';
    }
    return `Continued in the same process · ${tasks.length === 1 ? '1 task' : `${tasks.length} tasks`} still running`;
}
'''

# Per-run state. The writer is wrapped rather than captured: a message taken into
# a held run belongs to a NEW run with its own event sequence, and the loop must
# report there from that moment on -- while a `complete` passing through is what
# tells that run's caller its turn is over.
WAIT_STATE = r'''    // KIT: the CLI's own list of what is still outstanding, from its
    // `background_tasks_changed` events. The flag above only knows about work
    // the turn that just ended started; the list knows about all of it, which is
    // what a run resumed mid-wait needs in order not to release it.
    let kitTasks = [];
    let kitArmedMs = 0;
    let kitHoldStartedAt = 0;
    const kitCeilingMs = () => Math.min(KIT_WAIT_CEILING_MAX_MS,
        Math.max(BG_WAIT_CEILING_MS, kitArmedMs ? kitArmedMs + 120000 : 0));
    // KIT: the writer this run reports to -- wrapped rather than captured. A
    // message taken into a held run belongs to a NEW run with its own event
    // sequence, so the target is swapped when that happens, and a `complete`
    // passing through is what tells that run's caller its turn is over. Wrapped
    // with a Proxy so everything else about a writer (setSessionId, userId, the
    // reconnect path's updateWebSocket) reaches whichever one is current.
    const kitLive = { target: ws, onComplete: null };
    ws = new Proxy({}, {
        get: (_unused, prop) => {
            if (prop === 'send') {
                return (message) => {
                    const done = message?.kind === 'complete' ? kitLive.onComplete : null;
                    if (done) {
                        kitLive.onComplete = null;
                    }
                    try {
                        return kitLive.target.send(message);
                    }
                    finally {
                        done?.();
                    }
                };
            }
            const value = kitLive.target?.[prop];
            return typeof value === 'function' ? value.bind(kitLive.target) : value;
        },
        set: (_unused, prop, value) => {
            if (kitLive.target) {
                kitLive.target[prop] = value;
            }
            return true;
        },
        has: (_unused, prop) => prop in (kitLive.target || {}),
    });
'''

WAIT_TIMER = r'''        idleReleaseTimer = setTimeout(() => {
            idleReleaseTimer = null;
            // KIT: the wait ran out with nothing reported. Say so where the
            // conversation is; going quiet here is the whole complaint.
            if (kitHoldStartedAt) {
                ws.send(kitWaitRow(capturedSessionId || sessionId || null,
                    `Background work never reported back · waited ${kitFor(Date.now() - kitHoldStartedAt)}`,
                    { phase: 'expired', ms: Date.now() - kitHoldStartedAt, tasks: kitTasks }));
                kitHoldStartedAt = 0;
            }
            releasePromptStream();
        }, kitCeilingMs());
'''

WAIT_TASKS = r'''            // KIT: the CLI's own accounting of outstanding tasks. A list that
            // empties after being full is the work reporting in -- the one way a
            // wait ends well, and worth saying so.
            if (message?.type === 'system' && message.subtype === 'background_tasks_changed') {
                const kitWere = kitTasks.length;
                kitTasks = Array.isArray(message.tasks) ? message.tasks : [];
                if (kitWere && !kitTasks.length && kitHoldStartedAt) {
                    ws.send(kitWaitRow(sid,
                        `Background work reported back after ${kitFor(Date.now() - kitHoldStartedAt)}`,
                        { phase: 'reported', ms: Date.now() - kitHoldStartedAt }));
