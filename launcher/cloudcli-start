kitPathHref=v=>String(v).trim().replace(/:\d+(?::\d+)?$/,""),
kitTextOf=n=>n.type==="text"?n.value:Array.isArray(n.children)?n.children.map(kitTextOf).join(""):"",
kitFenced=n=>{const c=n.properties&&n.properties.className;
