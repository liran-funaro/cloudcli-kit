# is the one number worth seeing without going to look for it, in the sidebar
# footer above Settings, where the app already stacks rows of exactly this shape.
#
# Its data is the json sidecar litellm-cost.sh writes beside the report, not the
# report itself: the chip wants one number, and parsing a page to find it would
# tie the chip to that page's markup. No key reaches the browser either way --
# the file is already on disk, written by something that had the key.
#
# React state would be the obvious way to hold the number and the obvious way to
# get it wrong from here: hooks have to be declared unconditionally, in order,
# inside a component whose minified name is a guess away from being wrong. A ref
# callback needs none of that. React calls it with the node on mount and null on
# unmount, so the first mount starts one interval for the page's lifetime
# (guarded, so re-mounting the sidebar does not start a second), and every later
# render re-fills the node from the value already fetched -- which is why the
# number survives a re-render rather than blinking back to a dash.
COST_CHIP = (
    's.jsx("div",{className:"hidden px-2 pt-1.5 md:block",children:'
    's.jsx("div",{className:"flex w-full items-center gap-2 rounded-lg px-2.5 '
    'py-1.5 text-muted-foreground",children:s.jsx("span",{className:"text-sm '
    'tabular-nums","data-kit-cost":"1",title:"LiteLLM spend",'
    'ref:_e=>{if(!_e)return;'
    '_e.textContent=window.__kitCostText||"today —";'
    '_e.title=window.__kitCostTitle||"LiteLLM spend: no report yet";'
    'if(window.__kitCostTimer)return;'
    'const _p=async()=>{try{'
    'const _r=await fetch("/cost.json?t="+Date.now(),{cache:"no-store"});'
    'if(!_r.ok)return;const _j=await _r.json();'
    # The cycle is what is being tracked, so the chip carries it beside today --
    # a percentage of a cap rather than a total, since the total is not the thing
    # that runs out.
    'const _c=_j.cycle||{};'
    'window.__kitCostText="today $"+_j.today'
    '+(_c.pct!=null?" · cycle "+_c.pct+"%":(_c.spend?" · cycle $"+_c.spend:""));'
    'window.__kitCostTitle="LiteLLM spend — cycle $"+(_c.spend||"?")'
    '+(_c.cap?" of $"+_c.cap:"")+(_c.resets?", resets "+_c.resets+" ("+_c.days_left+"d)":"")'
