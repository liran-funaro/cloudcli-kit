kitProseStop=/^(?:node|next|nuxt|vue|react|three|d3|ember|express|nest|backbone|jquery)\.[jt]sx?$/i,
kitAnyExt=/\.[A-Za-z][A-Za-z0-9]{0,9}$/,
kitMime=/^(?:application|text|image|audio|video|multipart|font|model)\/[\w.+-]+$/i,
kitPathRe=/(^|[\s(\[{<"'|>])((?:~\/|\.{1,2}\/|\/)[\w.@~+-]+(?:\/[\w.@~+-]+)*|[\w.@+-]+(?:\/[\w.@~+-]+)+|[\w@+-]+\.[A-Za-z][A-Za-z0-9]{0,9})(:\d+(?::\d+)?)?/g,
kitIsPath=(v,loose)=>{const s=String(v==null?"":v).trim();
