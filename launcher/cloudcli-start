    # that edit first would leave nothing for it to match.
    for label, old, new, _ in RESUME + RUNTIME:
        runtime = unedit(runtime, old, new, label)
    for label, old, new, _ in SERVICE:
        service = unedit(service, old, new, label)
    for label, old, new, _ in CHAT:
        chat = unedit(chat, old, new, label)

open(rtp, 'w').write(runtime)
if service is not None:
    open(prs, 'w').write(service)
if chat is not None:
    open(cws, 'w').write(chat)

report = []
if applied:
    report.append('applied ' + ', '.join(applied))
if removed:
    report.append('removed ' + ', '.join(removed))
if already:
    report.append('%d already in place' % len(already))
for m in missing:
    print('  MISSING: %s -- upstream moved it' % m, file=sys.stderr)
print('chat: %s' % ('; '.join(report) or 'nothing to do'))
PY
  then
    if node --check "$RTP" >/dev/null 2>&1 && node --check "$PRS" >/dev/null 2>&1 \
       && node --check "$CWS" >/dev/null 2>&1; then
      rm -f "$RTP.prepatch" "$PRS.prepatch" "$CWS.prepatch"
    else
      kit_revert
      echo "WARNING: the chat patch broke syntax, reverted" >&2
    fi
  else
    kit_revert
    echo "WARNING: the chat patch failed, chat left as upstream had it" >&2
  fi
fi

# --- patch 9: compaction, said out loud --------------------------------------
# The server half. Compaction is the one thing the CLI does that CloudCLI never
# mentions: the normalizer knows deltas, text, thinking, tool calls and tool
# results and returns nothing at all for a `system` event -- so both events that
# describe a compaction are dropped, and the only trace left is the summary
# itself, which lands as a 24 KB assistant bubble with nothing in front of it to
# say what it is.
#
# Two events, one row. The status the CLI sends when it starts compacting
# becomes a row that says so; the boundary it sends when it is done becomes a
# row with the numbers -- which live under compact_metadata in the stream and
# compactMetadata in the transcript, so both spellings are read. Everything the
# row shows is in `content`, so an unpatched bundle renders it as the sentence it
# is; the `compact` field beside it is only how patch 9's browser half draws it.
#
# Not gated on CLOUDCLI_STEER: this adds a line to the transcript's own account
# of itself and takes nothing away, so there is nothing to turn off. Like the
# patches above it lands on the next server start.
CSP="$PKG/dist-server/server/modules/providers/list/claude/claude-sessions.provider.js"
if [[ -f $CSP ]]; then
  # Patch the file the package shipped, not whatever a previous kit left in it.
  # These edits are text substitutions, so a block this kit CHANGED between
  # versions would be inserted a second time: the syntax check catches that and
  # reverts, and the old block then stays installed forever, repeating the same
  # failure on every start. (The frontend needs none of this -- it always rebuilds
  # its patched copy from the bundle upstream shipped.)
  #
  # Self-healing across package upgrades, with no version to keep track of:
  # upstream never says KIT, so a file that does not is the original -- cache it.
  # One that does is ours, so put the original back before patching it again.
  kit_fresh=0
  for f in "$CSP"; do
    if ! grep -q KIT "$f"; then
      cp "$f" "$f.kitorig"
    elif [[ -f $f.kitorig ]]; then
      cp "$f.kitorig" "$f"
      kit_fresh=$((kit_fresh + 1))
    fi
  done
  if ((kit_fresh)); then
    echo "  re-patching $kit_fresh file(s) from the packaged originals"
  fi
  cp "$CSP" "$CSP.prepatch"
  if python3 - "$CSP" <<'PY'
import sys

path = sys.argv[1]
s = open(path).read()

# ts and baseId are wanted, so this goes in after them rather than ahead of the
# branches it precedes.
OLD = ("        const messages = [];\n"
       "        const ts = raw.timestamp || new Date().toISOString();\n"
       "        const baseId = raw.uuid || generateMessageId('claude');\n")
NEW = OLD + '''        // KIT: compaction ----------------------------------------------------
        // Neither event that describes it survives the branches below. Both
        // become one ordinary assistant row: what it says is in `content`, and
        // the `compact` field beside it is how the patched bundle draws it.
        if (raw.type === 'system' && (raw.subtype === 'compact_boundary' || raw.subtype === 'status')) {
            const kitTokens = (n) => n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}k` : `${n}`;
            const kitFor = (n) => {
                const secs = Math.round(n / 1000);
                return secs < 60 ? `${secs}s` : `${Math.floor(secs / 60)}m ${secs % 60}s`;
            };
            const kitRow = (content, compact) => [createNormalizedMessage({
                id: `${baseId}_compact`,
                sessionId,
                timestamp: ts,
                provider: PROVIDER,
                kind: 'text',
                role: 'assistant',
                content,
                compact,
            })];
            if (raw.subtype === 'compact_boundary') {
                // compact_metadata live, compactMetadata on disk.
                const meta = raw.compact_metadata || raw.compactMetadata || {};
                const trigger = meta.trigger === 'manual' ? 'manual' : 'auto';
                const pre = Number(meta.pre_tokens ?? meta.preTokens) || 0;
                const post = Number(meta.post_tokens ?? meta.postTokens) || 0;
                const ms = Number(meta.duration_ms ?? meta.durationMs) || 0;
                const said = ['Compacted', trigger];
                if (pre) {
                    said.push(post ? `${kitTokens(pre)} → ${kitTokens(post)} tokens`
                        : `${kitTokens(pre)} tokens`);
                }
                if (ms) {
                    said.push(kitFor(ms));
                }
                return kitRow(said.join(' · '), { phase: 'done', trigger, pre, post, ms });
            }
            // A status message reports several things, and compaction is the one
            // with anything to show: 'requesting' and null are every other turn.
            if (raw.status === 'compacting') {
                return kitRow('Compacting conversation…', { phase: 'running' });
            }
            if (raw.compact_result === 'failed') {
                return kitRow(`Compaction failed${raw.compact_error ? `: ${raw.compact_error}` : ''}`,
                    { phase: 'failed', error: raw.compact_error || null });
            }
            return [];
        }
'''

if 'KIT: compaction' in s:
    print('compaction: already in place')
    sys.exit(0)
if s.count(OLD) != 1:
    print('  MISSING: compaction (%d anchors) -- upstream moved it' % s.count(OLD),
          file=sys.stderr)
    sys.exit(1)
open(path, 'w').write(s.replace(OLD, NEW, 1))
print('compaction: applied')
PY
  then
    if node --check "$CSP" >/dev/null 2>&1; then
      rm -f "$CSP.prepatch"
    else
      mv "$CSP.prepatch" "$CSP"
      echo "WARNING: the compaction patch broke syntax, reverted" >&2
    fi
  else
    mv "$CSP.prepatch" "$CSP"
  fi
fi

# --- patch 11: a path in the chat, clickable (the server half) ----------------
# The browser half above makes a path in a message a link. This is what happens
# when one is clicked: the app asks the file-tree API to read the file, and that
# read is confined to the project root -- so a review an agent wrote for you
# into /tmp came back 403, and the link, now clickable, was still dead.
#
# One function gets a fallback, and only for reads: an ABSOLUTE path that
# resolves outside the project root is read anyway. Every write, rename, delete
# and upload still goes through upstream's check untouched, so the project root
# remains the only place this server will CHANGE anything.
#
# The bound this keeps is the one that matters for a process rather than for a
# user: the same logged-in session can already run `cat` in the Shell tab, so
# this grants the UI no reach it did not have. What it does refuse is the two
# ways a read can hurt the server itself -- the virtual filesystems, where a
# file reports a size it does not have and a read can never end, and a file too
# large to hand to a browser.
#
# CLOUDCLI_LINKS=0 turns the whole patch off, both halves, and puts this file
# back byte-identical with what upstream shipped.
FTS="$PKG/dist-server/server/modules/file-tree/file-tree.service.js"
if [[ -f $FTS ]]; then
  # Same self-healing as the sections above: upstream never says KIT, so a file
  # that does not is the original -- cache it. One that does is ours, so the
  # original goes back before it is patched again. With the flag off that
  # restore is the whole patch, in reverse.
  if ! grep -q KIT "$FTS"; then
    cp "$FTS" "$FTS.kitorig"
  elif [[ -f $FTS.kitorig ]]; then
    cp "$FTS.kitorig" "$FTS"
    [[ $LINKS == 1 ]] && echo "  re-patching the file reader from the packaged original"
  fi
fi
if [[ $LINKS == 1 && -f $FTS ]]; then
  cp "$FTS" "$FTS.prepatch"
  if python3 - "$FTS" <<'PY'
import sys

path = sys.argv[1]
s = open(path).read()

CONFINE = """function resolvePathInsideProject(projectRoot, targetPath) {
    const resolvedPath = path.isAbsolute(targetPath)
        ? path.resolve(targetPath)
        : path.resolve(projectRoot, targetPath);
    const normalizedProjectRoot = path.resolve(projectRoot) + path.sep;
    if (!resolvedPath.startsWith(normalizedProjectRoot)) {
        throw createFileTreeError('Path must be under project root', 403, 'PATH_OUTSIDE_PROJECT');
    }
    return resolvedPath;
}
"""
HELPER = CONFINE + """// KIT: reading a path that came from the chat ---------------------------------
// A path an agent hands you is not always inside the project -- the report it
// wrote for you lives in /tmp -- and a link to one is worth nothing if the read
// behind it is refused. So an absolute path that resolves outside the project
// root is read anyway. READS ONLY, and only from the two callers below: the
// check above still guards every write, rename, delete and upload, so the
// project root stays the only place this server will change anything.
const KIT_VIRTUAL_ROOTS = ['/proc', '/sys', '/dev'];
const KIT_MAX_TEXT_BYTES = 16 * 1024 * 1024;
async function kitResolveReadable(projectRoot, targetPath, fileSystem, maximumBytes) {
    try {
        return resolvePathInsideProject(projectRoot, targetPath);
    }
    catch (error) {
        if (!path.isAbsolute(targetPath)) {
            throw error;              // a relative path is relative to the project
        }
        const resolvedPath = path.resolve(targetPath);
        const normalizedPath = normalizeProjectPath(resolvedPath);
        // A virtual file reports a size it does not have, and a read of one can
        // never end. Nothing worth opening in a browser lives under these.
        if (KIT_VIRTUAL_ROOTS.some((root) => normalizedPath === root
            || normalizedPath.startsWith(`${root}/`))) {
            throw createFileTreeError('Path is not a readable file', 403, 'PATH_NOT_READABLE');
        }
        let stats;
        try {
            stats = await fileSystem.stat(resolvedPath);
        }
        catch {
            throw createFileTreeError('File not found', 404, 'FILE_NOT_FOUND');
        }
        if (!stats.isFile()) {
            throw createFileTreeError('Path is not a readable file', 403, 'PATH_NOT_READABLE');
        }
        if (maximumBytes && stats.size > maximumBytes) {
            throw createFileTreeError('File is too large to open', 413, 'FILE_TOO_LARGE');
        }
        return resolvedPath;
    }
}
"""

TEXT = """        async readTextFile(projectId, filePath) {
            const projectRoot = await resolveProjectRoot(projectId);
            const resolvedPath = resolvePathInsideProject(projectRoot, filePath);
"""
TEXT_NEW = """        async readTextFile(projectId, filePath) {
            const projectRoot = await resolveProjectRoot(projectId);
            const resolvedPath = await kitResolveReadable(projectRoot, filePath, fileSystem, KIT_MAX_TEXT_BYTES);
"""
# The blob route too, so a screenshot named in a message previews the way a text
# file reads. Streamed, so its size is the browser's problem rather than ours.
BLOB = """        async openFile(projectId, filePath) {
            const projectRoot = await resolveProjectRoot(projectId);
            const resolvedPath = resolvePathInsideProject(projectRoot, filePath);
"""
BLOB_NEW = """        async openFile(projectId, filePath) {
            const projectRoot = await resolveProjectRoot(projectId);
            const resolvedPath = await kitResolveReadable(projectRoot, filePath, fileSystem, 0);
"""

if 'KIT: reading a path' in s:
    print('file reads: already in place')
    sys.exit(0)
for label, old in (('helper', CONFINE), ('text read', TEXT), ('blob read', BLOB)):
    if s.count(old) != 1:
        print('  MISSING: file reads / %s (%d anchors) -- upstream moved it'
              % (label, s.count(old)), file=sys.stderr)
        sys.exit(1)
s = s.replace(CONFINE, HELPER, 1).replace(TEXT, TEXT_NEW, 1).replace(BLOB, BLOB_NEW, 1)
open(path, 'w').write(s)
print('file reads: applied')
PY
  then
    if node --check "$FTS" >/dev/null 2>&1; then
      rm -f "$FTS.prepatch"
    else
      mv "$FTS.prepatch" "$FTS"
      echo "WARNING: the file-read patch broke syntax, reverted" >&2
    fi
  else
    mv "$FTS.prepatch" "$FTS"
  fi
fi

# --- anchor self-check ------------------------------------------------------
# Every patch above hangs off something upstream happens to do: a Tailwind
# class, a CSS variable, a localStorage key. None of that is a published
# interface, so an upgrade can move one and the patch would go quietly
# ineffective -- the one genuine weakness of patching over forking. Check them
# by name so a silent failure becomes a loud one. This reports; it never edits.
# Checked against the pristine bundle, which is the file the anchors describe;
# patches 2 and 3 report on their own edits, by match count, as they make them.
AJS="${ENTRY:-}"
ACSS="$(ls "$PKG"/dist/assets/index-*.css 2>/dev/null | head -1 || true)"
ok=0; miss=0
check() {                            # check <label> <file> <literal>
  [[ -n $2 && -f $2 ]] || { echo "  MISSING: $1 (no such bundle)"; miss=$((miss + 1)); return; }
  if grep -qF -- "$3" "$2"; then
    ok=$((ok + 1))
  else
    echo "  MISSING: $1 -- upstream no longer has '$3'"
    miss=$((miss + 1))
  fi
}
if [[ -n $VER ]]; then
  check "sidebar density"    "$AJS"  'md:w-72'
  check "chat font size"     "$AJS"  'font-serif'
  check "inline-code chip"   "$AJS"  'prose-invert'
  check "accent variable"    "$ACSS" '--primary:'
  check "accent substitution" "$ACSS" 'blue-'
fi
if (( miss )); then
  echo "anchors: $ok ok, $miss MISSING -- those overrides will not apply; see the kit README" >&2
elif (( ok )); then
  echo "anchors: $ok/$ok ok"
fi

# --- the Cost tab's report ---------------------------------------------------
# A page in the static root, written by a script that talks to the LiteLLM proxy
# -- so the tab needs no server route, no key in the browser, and nothing
# upstream. Written here so the tab has something to show from the first reload;
# after that cloudcli-cost.timer keeps it current. Best-effort by construction:
# an upgrade wipes dist, no proxy env means no report, and neither is a reason to
# refuse to start. CLOUDCLI_COST=0 skips it.
COST_OUT="${CLOUDCLI_COST_OUT:-$PKG/dist/cost.html}"
if [[ ${CLOUDCLI_COST:-1} == 1 ]]; then
  COST_SH="$(command -v cloudcli-cost 2>/dev/null || true)"
  if [[ -z $COST_SH ]]; then
    echo "cost: no cloudcli-cost on PATH -- run install.sh to add the report" >&2
  elif CLOUDCLI_COST_OUT="$COST_OUT" "$COST_SH" >/dev/null 2>&1; then
    echo "cost: report written to ${COST_OUT#"$PKG/"}"
  else
    # The script still writes a page saying why, which is more use in the tab
    # than a 404 -- so this is a note, not a warning.
    echo "cost: proxy unreachable; the tab will say so (${COST_OUT#"$PKG/"})"
  fi
fi

if [[ ${CLOUDCLI_PATCH_ONLY:-0} == 1 ]]; then
  echo "patches applied; server not started (CLOUDCLI_PATCH_ONLY=1)"
  exit 0
fi

exec env HOST="${HOST:-127.0.0.1}" PORT="${PORT:-3001}" "$PREFIX/bin/cloudcli"
