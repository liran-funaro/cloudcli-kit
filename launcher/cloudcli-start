# The resume closure: what a message lands in when the turn is over but the
# process is still held. Placed beside the pusher, which is the other half of the
# same pipe, and gated with it.
RESUME_CLOSURE = r'''        // KIT: and how a message reaches this run once its turn is over but its
        // process is still held for background work. Returns a promise settling
        // when that message's own turn completes, so the caller can await it the
        // way it awaits a run -- or null, meaning "not mine", and the caller
        // starts a run as before.
        kitResumers.set(queryInstance, (text, writer) => {
            if (!heldForBackgroundWork || typeof text !== 'string' || !text.trim()) {
                return null;
            }
            const push = kitPushers.get(queryInstance);
            // A refused push means stdin is already released: the CLI is winding
            // down and the frame would go into a closed pipe.
            if (!push || !push({
                type: 'user',
                message: { role: 'user', content: text },
                parent_tool_use_id: null,
                timestamp: new Date().toISOString(),
            })) {
                return null;
