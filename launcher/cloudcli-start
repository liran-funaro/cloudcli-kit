# (9) Compaction and waiting, drawn -- the browser half of patches 9 and 10.
# Their server halves turn events CloudCLI used to drop into ordinary assistant
# rows carrying a `compact` or a `wait` field, so even unpatched they read as one
# sentence in the transcript. Here they become what the CLI shows: for a
# compaction a bar with its percentage, then the numbers with the summary folded
# in; for a wait a countdown, a draining bar, and what is being waited for --
# and then the one line saying how it ended.
#
# Two sites, one edit each. The mapper from normalized messages to chat messages
# carries both fields and drops rows that a later row has overtaken: a
# "compacting" bar once a boundary says it finished, and a "waiting" countdown
# once any newer wait row exists (so only the live one counts down, and history
# never shows a clock that will never stop). It also folds a compaction summary
# into the boundary row ahead of it. The row renderer then draws the result --
# two branches, inserted ahead of the task-notification branch they are modelled
# on.
#
# The look is not here: it is .kit-row-* in ide-theme.css, which is loaded after
# the app's stylesheet, so it can be retuned without re-patching. The only
# borrowed name is the markdown component, read from a site that names itself --
# and it is already called twice inside the function being patched, so it cannot
# be a local shadowing it there.
#
# The numbers tick from a ref callback rather than state, like the cost chip: one
# interval for the page, started by whichever row mounts first, stopping itself
# as soon as no row is left to update.
MAP = re.compile(r'const (\w+)=\[\],(\w+)=new Map,(\w+)=new Set;'
                 r'for\(const (\w+) of (\w+)\)\4\.kind==="tool_use"&&\4\.toolId'
                 r'&&\3\.add\(\4\.toolId\),\4\.kind==="tool_result"&&\4\.toolId'
                 r'&&\2\.set\(\4\.toolId,\4\);for\(const (\w+) of \5\)\{const (\w+)='
                 r'\{displayText:\6\.displayText,([^}]*?)isCompactSummary:'
                 r'\6\.isCompactSummary\};switch\(\6\.kind\)\{')
NOTIF = re.compile(r'(\w+)\.isTaskNotification\?(\w+)\.jsx\("div",\{className:"w-full",'
                   r'children:\2\.jsxs\("div",\{className:"flex items-center gap-2 py-0\.5"')
MD = kit_names(r'\w+\.jsx\((\w+),\{className:"prose prose-sm max-w-none font-serif '
               r'dark:prose-invert",children:String\(')

# Both readings come from the row's own timestamp attributes rather than from a
# captured start, so a row that re-renders (or a second tab) shows the same
# numbers, and the interval needs no bookkeeping to find its nodes.
#
# A row with a deadline counts down to it and drains its bar, which is the honest
# shape for a wait: the deadline is a real one the server chose. A row without
# one is a compaction, and gets the CLI's own estimate --
# min(95, round((1-e^(-t/90))*100)) over elapsed seconds, lifted formula and all
# out of the CLI binary. Nothing reports real compaction progress: the CLI draws
# that same curve under its spinner, easing toward a ceiling of 95% it never
# passes, so a compaction that runs long never reads as finished. Copying it
# rather than inventing a curve keeps the two windows telling the same story.
TICK = (
    'ref:_e=>{if(!_e)return;'
    'const _t=()=>{const _l=document.querySelectorAll("[data-kit-since]");'
    'if(!_l.length){clearInterval(window.__kitTick);window.__kitTick=null;return}'
    'const _n=Date.now();'
    'for(const _x of _l){const _s=Date.parse(_x.getAttribute("data-kit-since")||"");'
    'if(!_s)continue;const _u=Date.parse(_x.getAttribute("data-kit-until")||"");'
    'const _d=Math.max(0,Math.round((_n-_s)/1e3));'
    'const _p=_u?(_u>_s?Math.max(0,Math.min(100,Math.round((_u-_n)/(_u-_s)*100))):0)'
    ':Math.min(95,Math.round((1-Math.exp(-_d/90))*100));'
    'const _r=_u?Math.max(0,Math.round((_u-_n)/1e3)):_d;'
    'const _a=_x.querySelector(".kit-row-num");'
    'if(_a)_a.textContent=(_r<60?_r+"s":Math.floor(_r/60)+"m "+_r%60+"s")+(_u?" left":"");'
    'const _c=_x.querySelector(".kit-row-pct");if(_c)_c.textContent=_p+"%";'
    'const _f=_x.querySelector(".kit-row-fill");if(_f)_f.style.width=_p+"%"}};'
    '_t();if(!window.__kitTick)window.__kitTick=setInterval(_t,1e3)},'
)


def kit_row_map(m):
    """Carry both fields, drop an overtaken row, fold the summary into its row."""
    out, tmap, tset, it1, lst, it, ex, mid = m.groups()
    return (
        'const %(out)s=[],%(map)s=new Map,%(set)s=new Set;'
        'let _kitDone=-1,_kitWait=-1;'
        'for(const %(it1)s of %(lst)s)'
        '%(it1)s.kind==="tool_use"&&%(it1)s.toolId&&%(set)s.add(%(it1)s.toolId),'
        '%(it1)s.kind==="tool_result"&&%(it1)s.toolId&&%(map)s.set(%(it1)s.toolId,%(it1)s),'
        # The last row that reports a finished compaction, and the last wait row
        # of any kind. A bar or a countdown before either is history.
        '%(it1)s.compact&&%(it1)s.compact.phase!=="running"'
        '&&(_kitDone=%(lst)s.indexOf(%(it1)s)),'
        '%(it1)s.wait&&(_kitWait=%(lst)s.indexOf(%(it1)s));'
        'for(const %(it)s of %(lst)s){const %(ex)s={displayText:%(it)s.displayText,'
        '%(mid)sisCompactSummary:%(it)s.isCompactSummary,'
        'compact:%(it)s.compact,wait:%(it)s.wait};'
        'if(%(it)s.wait){'
        'if(%(it)s.wait.phase==="holding"&&%(lst)s.indexOf(%(it)s)<_kitWait)continue;'
        '%(out)s.push({type:"assistant",content:%(it)s.content||"",'
        'timestamp:%(it)s.timestamp,...%(ex)s});continue}'
        'if(%(it)s.compact||%(it)s.isCompactSummary){'
        'const _kitAt=%(out)s[%(out)s.length-1];'
        'if(%(it)s.isCompactSummary){'
        # The summary follows its boundary, so it belongs to the row already
        # drawn. On its own -- a session that compacted before the CLI recorded
        # boundaries -- it still gets a row of its own to fold into.
        'if(_kitAt&&_kitAt.compact&&!_kitAt.compactSummary)'
        '{_kitAt.compactSummary=%(it)s.content||"";continue}'
        '%(out)s.push({type:"assistant",content:"",timestamp:%(it)s.timestamp,'
        '...%(ex)s,compact:{phase:"done"},compactSummary:%(it)s.content||""});continue}'
        'if(%(it)s.compact.phase==="running"&&%(lst)s.indexOf(%(it)s)<_kitDone)continue;'
        '%(out)s.push({type:"assistant",content:%(it)s.content||"",'
        'timestamp:%(it)s.timestamp,...%(ex)s});continue}'
        'switch(%(it)s.kind){'
        % {'out': out, 'map': tmap, 'set': tset, 'it1': it1, 'lst': lst,
           'it': it, 'ex': ex, 'mid': mid})


def kit_row_row(m):
    """Two branches ahead of the task-notification row, modelled on it."""
    e, x = m.group(1), m.group(2)
    common = {'e': e, 'x': x, 'md': MD[0] if MD else '', 'tick': TICK}
    return (
        # --- a wait: the countdown is to a deadline the server chose, so the
        # bar drains rather than fills, and only a live wait carries the ticker.
        '%(e)s.wait?%(x)s.jsx("div",{className:"kit-row kit-wait",'
        '...(%(e)s.wait.phase==="holding"?{%(tick)s'
        '"data-kit-since":%(e)s.timestamp,"data-kit-until":%(e)s.wait.until}:{}),children:'
        '%(x)s.jsxs("div",{className:"kit-row-body",children:['
        '%(x)s.jsxs("div",{className:"kit-row-line",children:['
        '%(x)s.jsx("span",{className:"kit-row-dot"+('
        '%(e)s.wait.phase==="holding"?" is-running":'
        '%(e)s.wait.phase==="expired"?" is-failed":"")}),'
        '%(x)s.jsx("span",{children:%(e)s.content||"Waiting"}),'
        '%(e)s.wait.phase==="holding"?%(x)s.jsx("span",'
        '{className:"kit-row-num",children:"…"}):null]}),'
        '%(e)s.wait.phase==="holding"?%(x)s.jsx("div",{className:"kit-row-bar",'
        'children:%(x)s.jsx("div",{className:"kit-row-track",children:'
        '%(x)s.jsx("div",{className:"kit-row-fill"})})}):null,'
        '%(e)s.wait.tasks&&%(e)s.wait.tasks.length?'
        '%(x)s.jsxs("details",{className:"kit-row-more",children:['
        '%(x)s.jsx("summary",{children:"what it is waiting for"}),'
        '%(x)s.jsx("ul",{className:"kit-row-fold kit-wait-tasks",'
        'children:%(e)s.wait.tasks.map((_w,_i)=>%(x)s.jsx("li",{children:'
        '(_w.task_type||"task")+(_w.description?" · "+_w.description:"")},_i))})]}):null]})}):'
        # --- a compaction
        '%(e)s.compact?%(x)s.jsx("div",{className:"kit-row kit-compact",'
        '...(%(e)s.compact.phase==="running"'
        '?{%(tick)s"data-kit-since":%(e)s.timestamp}:{}),children:'
        '%(x)s.jsxs("div",{className:"kit-row-body",children:['
        '%(x)s.jsxs("div",{className:"kit-row-line",children:['
        '%(x)s.jsx("span",{className:"kit-row-dot"+('
        '%(e)s.compact.phase==="running"?" is-running":'
        '%(e)s.compact.phase==="failed"?" is-failed":"")}),'
        '%(x)s.jsx("span",{children:%(e)s.content||"Compacted"}),'
        '%(e)s.compact.phase==="running"?%(x)s.jsx("span",'
        '{className:"kit-row-num",children:"0s"}):null]}),'
        '%(e)s.compact.phase==="running"?%(x)s.jsxs("div",'
        '{className:"kit-row-bar",children:['
        '%(x)s.jsx("div",{className:"kit-row-track",children:%(x)s.jsx("div",'
        '{className:"kit-row-fill"})}),'
        '%(x)s.jsx("span",{className:"kit-row-pct",children:"0%%"})]}):null,'
        '%(e)s.compactSummary?%(x)s.jsxs("details",{className:"kit-row-more",'
        'children:[%(x)s.jsx("summary",{children:"full summary"}),'
        '%(x)s.jsx("div",{className:"kit-row-fold",children:%(x)s.jsx(%(md)s,'
        '{className:"prose prose-sm max-w-none font-serif dark:prose-invert",'
        'children:%(e)s.compactSummary})})]}):null]})}):'
        % common) + m.group(0)


counts = (len(MAP.findall(s)), len(NOTIF.findall(s)))
if MD and counts == (1, 1) and '_kitWait' not in s:
    s = MAP.sub(kit_row_map, s, count=1)
    s = NOTIF.sub(kit_row_row, s, count=1)
    applied.append('compaction and wait rows')
else:
    missing.append('compaction and wait rows (%s matches%s)'
                   % ('/'.join(str(c) for c in counts),
                      '' if MD else ', markdown unnamed'))

# (11) A path in the chat, clickable. The markdown renderer already turns a
# markdown LINK whose target looks like a file into one that opens that file in
# the editor -- it checks the href, then the link text, and hands either to the
# app's own openFileInEditor. What it never sees is a path that was not written
# as a link, which is every path an agent actually writes: bare in a sentence,
# or in backticks the way CLAUDE.md asks for it. Both stayed dead text.
#
