const text=kitTextOf(child).trim();
if(kitIsPath(text,!0)){child.properties=child.properties||{};
child.properties.className=[...Array.isArray(child.properties.className)?child.properties.className:[],"kit-path"];
kids.push({type:"element",tagName:"a",properties:{href:kitPathHref(text)},children:[child]}),hit=!0;continue}}
