            // The turn this starts belongs to the run that brought the message:
            // report there, and owe it a `complete`. The CLI writes the frame
            // into its transcript itself -- it is parked between turns, not
            // mid-turn -- so unlike a steer there is nothing to record here.
            if (writer) {
                kitLive.target = writer;
            }
            turnCompleteSent = false;
            heldForBackgroundWork = false;
            if (idleReleaseTimer) {
                clearTimeout(idleReleaseTimer);
                idleReleaseTimer = null;
            }
            if (kitHoldStartedAt) {
                ws.send(kitWaitRow(capturedSessionId || sessionId || null,
                    kitKeptText(kitTasks),
                    { phase: 'resumed', ms: Date.now() - kitHoldStartedAt, tasks: kitTasks }));
                kitHoldStartedAt = 0;
            }
            console.log(`[KIT] ${sessionKey()} took a message into its held run (${text.length} chars)`);
            return new Promise((resolve) => {
                let settled = false;
                const done = () => {
                    if (!settled) {
                        settled = true;
                        resolve();
                    }
                };
                kitLive.onComplete = done;
