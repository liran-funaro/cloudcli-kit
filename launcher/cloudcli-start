# "24/7" and "TCP/IP" stay words. In backticks, which is someone naming a file
# on purpose, any path with a slash counts, plus a bare filename whose extension
# is one of the ones below; that keeps `Array.isArray` and `2.1.235` from
# becoming links, and mime types are excluded by name.
KIT_PATHS = r'''const kitPathSkip=new Set(["a","pre","script","style","textarea","kbd","samp","math","semantics","annotation","svg"]),
