    '        // Call interrupt() on the query instance\n'
    '        await session.instance.interrupt();\n',
    '        // Call interrupt() on the query instance. KIT: it is a control\n'
    '        // request written to the CLI\'s stdin, which the SDK has already\n'
    '        // closed if this run reached its first result -- then it never\n'
    '        // answers and Stop wedges for good. Wait, then stop asking.\n'
    '        const kitInterrupt = await Promise.race([\n'
    '            session.instance.interrupt().then(() => \'done\', (error) => error),\n'
    '            new Promise((resolve) => setTimeout(() => resolve(\'timeout\'), 2000)),\n'
    '        ]);\n'
