#!/usr/bin/env bash
# Launch CloudCLI (Claude Code web UI) on loopback, re-applying local patches
# every start so a package upgrade cannot silently revert them.
#
#   CLOUDCLI_PATCH_ONLY=1 cloudcli-start
#       Apply the patches to the installed files and exit, starting nothing.
#       Safe to run while a session is in progress -- the running server is
#       untouched; the browser picks the changes up on its next reload.
#
#   CLOUDCLI_STEER=0 cloudcli-start
#       Turn off steering (patch 5), which is otherwise ON: a message sent
#       while a turn is running goes INTO that turn instead of being held back
#       as a draft, and is recorded in the CLI transcript so it survives a
#       reload. Off reverses all eight server edits, back to byte-identical
#       with what upstream shipped.
#       In a tab that is already open, `__cloudcliSteer = false` in the console
#       restores upstream's hold-it-back composer without a restart.
#
# The appearance this applies is not carried here. It lives in
# ~/.config/cloudcli/ide-theme.css, seeded by install.sh from the cloudcli-kit
# repo and never overwritten here -- so it survives package upgrades AND kit
# updates, and this script has no second copy of it to drift from. Delete it
# and the next run cleanly un-links it.
#
# What this script does carry is the model-description table in patch 3, which
# is content by necessity: nothing on the machine knows what a model costs.
set -euo pipefail

PREFIX="${CLOUDCLI_PREFIX:-$HOME/.npm-global}"
PKG="$PREFIX/lib/node_modules/@cloudcli-ai/cloudcli"
CONF="${CLOUDCLI_CONF:-$HOME/.config/cloudcli}"
SRC="${CLOUDCLI_THEME:-$CONF/ide-theme.css}"
DROP_MODELS="${CLOUDCLI_DROP_MODELS:-fable best}"
FRONTEND="${CLOUDCLI_FRONTEND:-1}"
STEER="${CLOUDCLI_STEER:-1}"

if [[ ! -d $PKG ]]; then
  echo "installing @cloudcli-ai/cloudcli into $PREFIX ..."
  npm install -g --prefix "$PREFIX" @cloudcli-ai/cloudcli >/dev/null 2>&1
fi
[[ -d $PKG ]] || { echo "install failed: $PKG missing" >&2; exit 1; }

# Three of the server's dependencies are native, and only an install script
# gives them a loadable binary. npm 11 records which dependencies may run one
# and warns about the rest -- advisory for now, but its own docs say a future
# release will block the unreviewed ones, which would leave an install that
# imports fine right up to its first query. Check here, where the failure can
# still be explained, rather than leaving Restart=on-failure to discover it.
for m in better-sqlite3 bcrypt node-pty; do
  (cd "$PKG" && node -e "require('$m')") >/dev/null 2>&1 && continue
  {
    echo "$m has no loadable binary -- its install script did not run."
    echo "Approve the scripts and rebuild, then start again:"
    echo "  npm approve-scripts --allow-scripts-pending    # see what is pending"
    echo "  npm rebuild -g --prefix $PREFIX $m"
  } >&2
  exit 1
done

# The copies land at the dist ROOT, deliberately not appended to the hashed
# assets in dist/assets/: the service worker (dist/sw.js) is cache-first for
# /assets/ and network-first for everything else, so a file here is never
# served from a stale service-worker cache.
CSS="$PKG/dist/ide-theme.css"
VER=""

# Earlier versions served a Recent-conversations list of their own, first as a
# floating pill and then as a plugin tab. Both are gone: the sidebar's own
# Conversations tab, with the patches below, is that list. Clear the copy the
# pill served; index.html's tag for it is dropped further down.
rm -f "$PKG/dist/ide-recent.js"

# --- patch 1: appearance (colours, chat typography, full width) --------------
if [[ -f $SRC ]]; then
  cp -f "$SRC" "$CSS"

  # Recolouring --primary is not enough on its own: the app also hardcodes
  # Tailwind blue utilities (bg-blue-600, text-blue-400, ...) that no variable
  # reaches, so the UI would come out two-toned. Append a substitution for
  # every blue utility the bundle defines, moving each one to the --primary hue
  # at its own relative luminance -- so contrast against the surfaces behind it
  # is preserved by construction rather than guessed. Generated on each start
  # because an upgrade can add utilities; delete --primary from the stylesheet
  # and this whole step disappears.
  APP_CSS="$(ls "$PKG"/dist/assets/index-*.css 2>/dev/null | head -1 || true)"
  if [[ -n ${APP_CSS:-} ]]; then
    ACC="$(mktemp)"
    python3 - "$APP_CSS" "$CSS" >"$ACC" <<'PY'
import re, sys

app_css, theme_css = sys.argv[1], sys.argv[2]
m = re.search(r'--primary:\s*([\d.]+)\s+([\d.]+)%', open(theme_css).read())
if not m:
    sys.exit(0)                                  # accent not overridden
HUE, SAT = float(m.group(1)), float(m.group(2)) / 100

def lin(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4

def luminance(rgb):
    r, g, b = (lin(c / 255) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

def hsl(l):
    c = (1 - abs(2 * l - 1)) * SAT
    h = HUE / 60
    x = c * (1 - abs(h % 2 - 1))
    r, g, b = [(c, x, 0), (x, c, 0), (0, c, x),
               (0, x, c), (x, 0, c), (c, 0, x)][int(h) % 6]
    return tuple(round((v + l - c / 2) * 255) for v in (r, g, b))

def accent(rgb):                                 # new hue, same luminance
    target, lo, hi = luminance(rgb), 0.0, 1.0
    for _ in range(24):
        mid = (lo + hi) / 2
        lo, hi = (mid, hi) if luminance(hsl(mid)) < target else (lo, mid)
    return hsl((lo + hi) / 2)

def rules(css):
    """(at-rule stack, selector, declarations) for every rule, nesting kept."""
    stack, head, i = [], '', 0
    while i < len(css):
        ch = css[i]
        if ch == '{':
            if head.strip().startswith('@'):
                stack.append(head.strip())
            else:
                end = css.find('}', i)           # no nested braces in a block
                if end < 0:
                    return
                yield tuple(stack), head.strip(), css[i + 1:end]
                i = end
            head = ''
        elif ch == '}':
            head = ''
            if stack:
                stack.pop()
        elif ch == ';':
            head = ''
        else:
            head += ch
        i += 1

RGB = re.compile(r'rgb\(\s*(\d+)\s+(\d+)\s+(\d+)(\s*/[^)]*)?\)')
HEX = re.compile(r'#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?')
sub_rgb = lambda m: 'rgb(%d %d %d%s)' % (accent(tuple(int(g) for g in m.groups()[:3]))
                                         + (m.group(4) or '',))
sub_hex = lambda m: '#%02x%02x%02x%s' % (accent(tuple(int(m.group(1)[i:i + 2], 16)
                                                      for i in (0, 2, 4)))
                                         + (m.group(2) or '',))

out = []
for ats, sel, decl in rules(open(app_css).read()):
    if 'blue-' not in sel:
        continue
    new = HEX.sub(sub_hex, RGB.sub(sub_rgb, decl))
    if new == decl:
        continue
    # The uniform .dark prefix adds one class to every selector, so it outranks
    # the original while keeping the rules' order among themselves; !important
    # keeps that order decided by specificity, as it was upstream.
    line = '.dark %s{%s}' % (sel, ';'.join(d.strip() + ' !important'
                                           for d in new.split(';') if d.strip()))
    for at in reversed(ats):
        line = '%s{%s}' % (at, line)
    out.append(line)

if out:
    print('\n/* --- accent, derived from --primary by cloudcli-start --------------')
    print('   %d hardcoded Tailwind blue rules, rehued at equal luminance.' % len(out))
    print('   Regenerated on every start -- edit --primary above, not this. */')
    print('\n'.join(out))
PY
    cat "$ACC" >>"$CSS"; rm -f "$ACC"
  fi

  # The server sends Cache-Control: immutable for every static file, so the
  # <link> needs a version query or an edited stylesheet stays pinned in the
  # browser cache. Hash the served copy, accent section included.
  VER="$(md5sum "$CSS" | cut -c1-8)"
else
  rm -f "$CSS"
  echo "no stylesheet at $SRC -- skipping appearance (run install.sh from cloudcli-kit)"
fi

# --- patch 2: frontend behaviours, and one default worth flipping ------------
# Four small changes in the app bundle, each made in a COPY: the upstream
# index-*.js is never written to, which makes this idempotent by construction
# and leaves an untouched original to fall back to.
#
# The copy is content-addressed (ide-<md5>.js) rather than patched in place
# because the server sends Cache-Control: immutable for /assets/ and the
# bundled service worker is cache-first there -- a browser that has already
# loaded the entry chunk would never ask for it again. A new name is a new
# cache entry, and index.html is served no-store, so a reload always picks it
# up. Set CLOUDCLI_FRONTEND=0 to serve the bundle untouched.
ENTRY="$(ls "$PKG"/dist/assets/index-*.js 2>/dev/null | head -1 || true)"
BJS=""
if [[ -n ${ENTRY:-} && $FRONTEND == 1 ]]; then
  TD="$(mktemp -d)"
  # .mjs so `node --check` parses it as a module regardless of where it sits.
  if python3 - "$ENTRY" "$TD/entry.mjs" "$STEER" <<'PY'
import re, sys

src, out, steer = sys.argv[1], sys.argv[2], sys.argv[3] == '1'
s = open(src).read()
applied, missing = [], []

# Each anchor must match EXACTLY once. A minified bundle offers no way to tell
# the intended site from a coincidence, so anything other than one match is
# reported and skipped rather than guessed at.

# (1) The sidebar's Projects/Conversations/Archived switch is React state that
# is never persisted, so it returns to Projects on every load. Conversations
# is the list actually worth landing on.
MODE = 'useState("projects")'
if s.count(MODE) == 1:
    s = s.replace(MODE, 'useState("conversations")')
    applied.append('sidebar default')
else:
    missing.append('sidebar default (%d matches)' % s.count(MODE))

# (2) Every model option carries a description, and the shared menu-item
# component renders one when given one -- the effort menu right next door
# passes exactly this prop, the model menu just never does. Matched
# structurally, with a backreference, so the minifier's choice of variable
# name does not matter.
ITEM = re.compile(r'label:(\w+)\.label\|\|\1\.value,isSelected:')
if len(ITEM.findall(s)) == 1:
    s = ITEM.sub(r'label:\1.label||\1.value,description:\1.description,'
                 r'isSelected:', s)
    applied.append('model description')
else:
    missing.append('model description (%d matches)' % len(ITEM.findall(s)))

# (3) Enter for a newline, Cmd/Ctrl+Enter to send. Unlike the two above this
# one HAS a setting -- Quick Settings (the tab on the right edge) > Input
# Settings > "Send by Ctrl+Enter" -- it just defaults off. This flips that one
# default and nothing else, which bounds what it can do: the preferences hook
# persists the whole object to localStorage.uiPreferences on its FIRST render,
# so a profile that has already opened the app has sendByCtrlEnter:false written
# down and a stored value wins -- there it takes one flip of the toggle. This is
# what a fresh profile starts from, and the toggle still works either way.
SEND = 'sendByCtrlEnter:!1'
if s.count(SEND) == 1:
    s = s.replace(SEND, 'sendByCtrlEnter:!0')
    applied.append('ctrl+enter to send')
else:
    missing.append('ctrl+enter to send (%d matches)' % s.count(SEND))

# (5) Send-while-running, with CLOUDCLI_STEER=1 -- the browser half of patch 5.
# Type into a turn that is still running and upstream holds the text back as a
# draft, replaying it only once the turn ends; the server patch can instead push
# it into the live turn, so a correction lands while it still matters. What that
# takes here is letting the composer's busy branch fall through to the ordinary
# send path -- which appends the bubble, clears the box and emits chat.send, all
# of it already correct for a run in progress.
#
# Guarded on a global rather than compiled in, so the tab keeps an escape
# hatch: `__cloudcliSteer = false` in the console restores upstream's
# hold-it-back composer mid-session, with no reload. Only that exact value
# does -- unset means steer, matching the server half, which is on unless
# CLOUDCLI_STEER=0. Matched structurally: the busy flag, the override argument
# and the queue setter are all one-letter minifier names that an upgrade will
# renumber, but the shape holds.
if steer:
    BUSY = re.compile(r'if\((\w+)\)\{if\((\w+)\)\{(\w+)\.current=(\w+),(\w+)\(\2\);return\}')
    if len(BUSY.findall(s)) == 1:
        s = BUSY.sub(r'if(\1&&window.__cloudcliSteer===!1){if(\2){\3.current=\4,\5(\2);'
                     r'return}', s, count=1)
        applied.append('send while running')
    else:
        missing.append('send while running (%d matches)' % len(BUSY.findall(s)))

# (5) A Conversations row, drawn the way a Projects session row is drawn. The
# two lists show the same sessions, and the Projects one says far more about
# one: a dot at the left edge, amber when it needs an answer and green when it
# was touched in the last ten minutes; a spinner while it works, or how long
# ago it was touched; and a three-dot menu that renames, copies the provider
# session id and archives or deletes. The Conversations row had none of it --
# just a chevron that says nothing the row does not, the row being a link.
#
# So the whole row is replaced with that one, built from the app's own pieces:
# its button variants, its Tooltip, its spinner, its provider mark, its
# ActionMenu and icons. The one thing added is the line a row under a project
# does not need -- which project it belongs to -- where a session row shows its
# message count. Nothing is invented; the state was already on the props object
# this call site reads selectedSession and currentTime off, so one more prop
# carries the lot, and rename and delete key on the session id alone (their
# projectId and provider arguments are compatibility parameters upstream marks
# unused), so a row holding only a conversation summary can drive both.
#
# Twelve of the names below are the minifier's, and not one is guessed: each is
# read from a site that names itself -- the Projects row for its button
# variants, Tooltip, spinner and menu, the copy-state ternary for the clipboard
# icon, the api object from its own call, the clipboard helper from its
# writeText branch, and the row's own locals from the line that declares them.
# A name already present in the target function could be a local that shadows
# it, so that is checked too, and nothing is applied if it is.


def kit_names(pattern):
    """Names the minifier chose, from a site that says which is which.

    Returns the groups, or None unless every match agrees on them. One match is
    the usual case; a shape that appears twice -- the mobile and desktop halves
    of a row, say -- still identifies the same thing as long as both name it the
    same. Disagreement means the shape no longer identifies what it used to.
    """
    found = {m.groups() for m in re.finditer(pattern, s)}
    return found.pop() if len(found) == 1 else None


MENU = kit_names(r's\.jsx\((\w+),\{label:"Session options",ariaLabel:`Session '
                 r'options for \$\{\w+\.sessionName\}`,icon:(\w+),iconOnly:!0')
EDIT = kit_names(r'\{key:"rename",label:"Rename session",icon:(\w+),onSelect:')
TRASH = kit_names(r'\{key:"delete",label:"Archive or delete session",'
                  r'icon:(\w+),isDanger:!0')
COPY = kit_names(r'\w+==="copied"\?\w+:(\w+),')
APIO = kit_names(r'(\w+)\.providerSessionId\(')
CLIP = kit_names(r'async function (\w+)\(\w+\)\{if\(!\w+\)return!1;let \w+=!1;'
                 r'try\{typeof navigator<"u"&&navigator\.clipboard\?\.writeText')
SAVE = kit_names(r's\.jsx\((\w+),\{className:"h-3 w-3 text-green-600 '
                 r'dark:text-green-400"\}\)')
DROP = kit_names(r's\.jsx\((\w+),\{className:"h-3 w-3 text-gray-600 '
                 r'dark:text-gray-400"\}\)')
# The Projects row names four more just by being itself: the classname helper
# and button variants that give it its card, its spinner, and its Tooltip.
CARD = kit_names(r'className:(\w+)\((\w+)\(\{variant:"ghost"\}\),"h-auto w-full '
                 r'justify-start rounded-md border bg-card p-2 pr-11 text-left '
                 r'font-normal transition-all duration-150"')
SPIN = kit_names(r'className:"flex h-5 w-5 items-center justify-center rounded-md '
                 r'text-muted-foreground",children:s\.jsx\((\w+),'
                 r'\{className:"h-3 w-3 animate-spin"\}\)')
TIP = kit_names(r's\.jsx\((\w+),\{content:\w+\?\w+\("tooltips\.'
                r'attentionRequiredIndicator"')
# And the row names its own: the mark it draws, the locals it derives, the
# translator it was handed.
LOGO = kit_names(r's\.jsx\((\w+),\{provider:\w+\.provider,className:"h-3\.5 w-3\.5"\}\)')
LOCAL = kit_names(r'const (\w+)=String\((\w+)\?\.id\?\?""\)===(\w+)\.sessionId,'
                  r'(\w+)=(\w+)\(\3\.lastActivity,(\w+)\),(\w+)=')
XLATE = kit_names(r'onLoadMore:(\w+),onRetry:(\w+),t:(\w+)\}\)\{return')

# The list's props, its own signature, and the row itself -- from the return
# that opens it to the chevron and key that close it.
CALL = re.compile(r'selectedSession:(\w+)\.selectedSession,currentTime:\1\.currentTime,')
SIG = re.compile(r'hasError:(\w+),selectedSession:(\w+),currentTime:(\w+),')
ROW = re.compile(r'return s\.jsxs\("a",\{href:`/session/\$\{(\w+)\.sessionId\}`,'
                 r'onClick:(\w+),"data-testid":"recent-conversation-row"'
                 r'[\s\S]*?s\.jsx\(\w+,\{className:"h-3\.5 w-3\.5 flex-shrink-0 '
                 r'text-muted-foreground/40 transition-transform '
                 r'group-hover:translate-x-0\.5 group-hover:text-muted-foreground"\}\)'
                 r'\]\},\1\.sessionId\)')


def kit_row(names):
    """The replacement row, in the app's own vocabulary.

    Everything it reads is either a name the app chose for itself or one of the
    row's own locals; the only names it introduces are _kit-prefixed, which the
    minifier does not emit and which the caller has checked are free.
    """
    return ('const _kitBusy=_kitRow?.activeSessions?.has(%(conv)s.sessionId),'
            '_kitAsk=!!_kitRow?.attentionSessionIds?.has(%(conv)s.sessionId)'
            '&&!%(sel)s,'
            '_kitEdit=_kitRow?.editingSession===%(conv)s.sessionId,'
            # The app's own rule for "recently active": within ten minutes of
            # the clock it already ticks once a minute for exactly this.
            '_kitNew=!!%(conv)s.lastActivity&&%(now)s.getTime()-'
            'new Date(%(conv)s.lastActivity).getTime()<6e5,'
            '_kitDot=_kitAsk||!_kitBusy&&_kitNew,'
            '_kitSays=_kitAsk?%(t)s("tooltips.attentionRequiredIndicator",'
            '{defaultValue:"Session needs attention"}):'
            '%(t)s("tooltips.activeSessionIndicator");'
            'return s.jsxs("div",{className:"group relative",children:['
            # the dot, at the left edge, outside the card
            '_kitDot&&s.jsx("div",{className:"absolute left-0 top-1/2 '
            '-translate-x-1 -translate-y-1/2 transform",children:'
            's.jsx(%(tip)s,{content:_kitSays,position:"right",children:'
            's.jsx("div",{role:"status","aria-label":_kitSays,'
            'className:"h-2 w-2 animate-pulse rounded-full "+'
            '(_kitAsk?"bg-amber-500":"bg-green-500")})})}),'
            # the card
            's.jsx("a",{href:`/session/${%(conv)s.sessionId}`,onClick:%(click)s,'
            '"data-testid":"recent-conversation-row",'
            'className:%(cn)s(%(btn)s({variant:"ghost"}),"h-auto w-full '
            'justify-start rounded-md border bg-card p-2 pr-11 text-left '
            'font-normal transition-all duration-150",'
            '%(sel)s?"border-primary/20 bg-primary/5":"border-border/30",'
            '!%(sel)s&&_kitBusy?"border-border/60 bg-muted/20 hover:bg-muted/25"'
            ':!%(sel)s&&_kitNew?"border-green-500/30 bg-green-50/5 '
            'hover:bg-green-50/10 dark:bg-green-900/5 dark:hover:bg-green-900/10"'
            ':"hover:bg-accent/50"),children:'
            's.jsxs("div",{className:"flex w-full min-w-0 items-center gap-2",'
            'children:[s.jsx("div",{className:%(cn)s("flex h-5 w-5 flex-shrink-0 '
            'items-center justify-center rounded-md",'
            '%(sel)s?"bg-primary/10":"bg-muted/50"),children:'
            's.jsx(%(logo)s,{provider:%(conv)s.provider,className:"h-3 w-3"})}),'
            's.jsxs("div",{className:"min-w-0 flex-1",children:['
            's.jsxs("div",{className:"flex items-center gap-2",children:['
            's.jsx("div",{className:"min-w-0 flex-1 truncate text-sm font-normal '
            'text-foreground",title:%(conv)s.sessionTitle,'
            'children:%(conv)s.sessionTitle}),'
            # working, or when it last was
            '_kitBusy?s.jsx("span",{className:"ml-auto flex-shrink-0 '
            'transition-opacity duration-200 "+(_kitEdit?"opacity-0":'
            '"group-hover:opacity-0"),children:s.jsx(%(tip)s,{content:'
            '%(t)s("tooltips.processingSessionIndicator","Processing session"),'
            'position:"top",children:s.jsx("span",{className:"flex h-5 w-5 '
            'items-center justify-center rounded-md text-muted-foreground",'
            'children:s.jsx(%(spin)s,{className:"h-3 w-3 animate-spin"})})})}):'
            '%(age)s&&s.jsx("span",{className:"ml-auto flex-shrink-0 '
            'text-[11px] text-muted-foreground transition-opacity duration-200 "+'
            '(_kitEdit?"opacity-0":"group-hover:opacity-0"),children:%(age)s})]}),'
            # the line a session row under a project does not need
            's.jsx("div",{className:"mt-0.5 flex min-w-0 items-center",children:'
            's.jsx("span",{className:"truncate text-[10px] leading-3 '
            'text-muted-foreground",children:%(conv)s.projectDisplayName})})]})]})}),'
            # and the controls, over the right edge, where the Projects row has them
            's.jsx("div",{className:"absolute right-2 top-1/2 flex '
            '-translate-y-1/2 transform items-center gap-1",children:_kitEdit?'
            's.jsxs(s.Fragment,{children:['
            's.jsx("input",{type:"text","aria-label":"Session name",autoFocus:!0,'
            'value:_kitRow.editingSessionName,'
            'onChange:_e=>_kitRow.onEditingSessionNameChange(_e.target.value),'
            # Leaving the controls cancels, as clicking outside them does in the
            # Projects list; save and cancel keep the focus (see onMouseDown).
            'onBlur:_e=>{_e.currentTarget.parentElement?.contains(_e.relatedTarget)'
            '||_kitRow.onCancelEditingSession()},'
            'onKeyDown:_e=>{_e.stopPropagation(),_e.key==="Enter"?'
            # An IME sends Enter to accept a candidate, not to save.
            '_e.nativeEvent.isComposing||_kitRow.onSaveEditingSession('
            '%(conv)s.projectId,%(conv)s.sessionId,_kitRow.editingSessionName,'
            '%(conv)s.provider):_e.key==="Escape"&&'
            '_kitRow.onCancelEditingSession()},'
            'className:"w-32 rounded border border-border bg-background px-2 '
            'py-1 text-xs focus:outline-none focus:ring-1 focus:ring-primary"}),'
            's.jsx("button",{type:"button",title:%(t)s("tooltips.save"),'
            'onMouseDown:_e=>_e.preventDefault(),'
            'onClick:()=>_kitRow.onSaveEditingSession(%(conv)s.projectId,'
            '%(conv)s.sessionId,_kitRow.editingSessionName,%(conv)s.provider),'
            'className:"flex h-6 w-6 items-center justify-center rounded '
            'bg-green-50 hover:bg-green-100 dark:bg-green-900/20 '
            'dark:hover:bg-green-900/40",children:'
            's.jsx(%(check)s,{className:"h-3 w-3 text-green-600 '
            'dark:text-green-400"})}),'
            's.jsx("button",{type:"button",title:%(t)s("tooltips.cancel"),'
            'onMouseDown:_e=>_e.preventDefault(),'
            'onClick:()=>_kitRow.onCancelEditingSession(),'
            'className:"flex h-6 w-6 items-center justify-center rounded '
            'bg-gray-50 hover:bg-gray-100 dark:bg-gray-900/20 '
            'dark:hover:bg-gray-900/40",children:'
            's.jsx(%(cross)s,{className:"h-3 w-3 text-gray-600 '
            'dark:text-gray-400"})})]}):'
            's.jsx(%(menu)s,{label:"Session options",'
            'ariaLabel:`Session options for ${%(conv)s.sessionTitle}`,'
            'icon:%(dots)s,iconOnly:!0,portal:!0,variant:"ghost",size:"icon",'
            'triggerClassName:"h-7 w-7 text-muted-foreground opacity-70 '
            'hover:bg-muted hover:opacity-100",'
            'menuClassName:"w-[260px] rounded-xl p-1.5 shadow-xl",'
            'items:[{key:"rename",label:"Rename session",icon:%(edit)s,'
            'onSelect:()=>_kitRow.onStartEditingSession(%(conv)s.sessionId,'
            '%(conv)s.sessionTitle)},'
            # The one item without the Projects menu's loading and copied
